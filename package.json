{
  "name": "modus-next-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/app",
    "packages/demos"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=modus-next-app",
    "dev:demos": "npm run dev --workspace=@modus-next-app/demos",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=modus-next-app",
    "lint": "npm run lint --workspaces",
    "type-check": "node scripts/check-typescript.js packages/app packages/demos",
    "lint:colors": "node scripts/check-modus-colors.js packages/app packages/demos",
    "lint:icons": "node scripts/check-modus-icons.js packages/app packages/demos",
    "lint:styles": "node scripts/check-inline-styles.js packages/app packages/demos",
    "lint:semantic": "node scripts/check-semantic-html.js packages/app packages/demos",
    "lint:borders": "node scripts/check-border-violations.js packages/app packages/demos",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "packages/app/**/*.{tsx,ts,jsx,js,css,scss}": [
      "npm run type-check",
      "npm run lint:colors",
      "npm run lint:icons",
      "npm run lint:styles",
      "npm run lint:semantic"
    ],
    "packages/demos/**/*.{tsx,ts,jsx,js,css,scss}": [
      "npm run type-check",
      "npm run lint:colors",
      "npm run lint:icons",
      "npm run lint:styles",
      "npm run lint:semantic"
    ],
    "scripts/**/*.{tsx,ts,jsx,js,css,scss}": [
      "npm run type-check",
      "npm run lint:colors",
      "npm run lint:icons",
      "npm run lint:styles",
      "npm run lint:semantic"
    ],
    "*.{css,scss}": [
      "npm run lint:colors",
      "npm run lint:icons",
      "npm run lint:styles"
    ]
  }
}
