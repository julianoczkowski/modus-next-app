# Modus Web Components Dropdown Event Handling in Next.js

This rule documents the critical patterns and solutions discovered when implementing interactive Modus Web Components (specifically dropdown menus) in Next.js applications with React 19.

## 🎯 Core Problem: React Event Props vs Native Web Component Events

### The Challenge

Modus Web Components use native DOM events that don't always map perfectly to React's synthetic event system. When using the React wrapper package (`@trimble-oss/moduswebcomponents-react`), event handlers passed as props (like `onItemSelect`) may not fire reliably.

### Common Symptoms

- Event handlers defined as React props don't execute
- No console logs or debug output from event handlers
- Components appear to work visually but lack interactivity
- No TypeScript errors, but functionality is missing

## 🔧 Solution: Hybrid Event Handling Pattern

### Primary Approach: Direct DOM Event Listeners

Use `useEffect` with `addEventListener` to attach event listeners directly to the web component DOM element:

```tsx
"use client";

import { useRef, useEffect } from "react";
import {
  ModusWcDropdownMenu,
  ModusWcMenuItem,
} from "@trimble-oss/moduswebcomponents-react";

export default function InteractiveDropdown() {
  const dropdownRef = useRef<any>(null);

  useEffect(() => {
    const dropdown = dropdownRef.current;
    if (dropdown) {
      const handleItemSelect = (event: CustomEvent) => {
        const selectedValue = event.detail?.value;
        console.log("Item selected:", selectedValue);
        // Handle the selection
      };

      // Attach event listener directly to DOM element
      dropdown.addEventListener("itemSelect", handleItemSelect);

      // Cleanup function to prevent memory leaks
      return () => {
        dropdown.removeEventListener("itemSelect", handleItemSelect);
      };
    }
  }, []); // Empty dependency array for component mount/unmount only

  return (
    <ModusWcDropdownMenu ref={dropdownRef}>
      <div slot="button">Select Option</div>
      <div slot="menu">
        <ModusWcMenuItem label="Option 1" value="option1" />
        <ModusWcMenuItem label="Option 2" value="option2" />
      </div>
    </ModusWcDropdownMenu>
  );
}
```

### Secondary Approach: React Event Props (Backup)

Keep React event props as a fallback, even if they don't work reliably:

```tsx
<ModusWcDropdownMenu
  ref={dropdownRef}
  onItemSelect={handleItemSelect} // Backup approach
  onMenuVisibilityChange={handleMenuVisibility}
>
```

## 🎨 Complete Implementation Pattern

### Theme Switcher Example

```tsx
"use client";

import { useTheme, type Theme } from "../contexts/ThemeContext";
import { useState, useEffect, useRef } from "react";
import {
  ModusWcDropdownMenu,
  ModusWcMenuItem,
} from "@trimble-oss/moduswebcomponents-react";

interface ThemeSwitcherDropdownProps {
  className?: string;
}

function ThemeSwitcherDropdownContent({
  className = "",
}: ThemeSwitcherDropdownProps) {
  const { theme, setTheme } = useTheme();
  const dropdownRef = useRef<any>(null);

  const themes: { value: Theme; label: string }[] = [
    { value: "modus-classic-light", label: "Classic Light" },
    { value: "modus-classic-dark", label: "Classic Dark" },
    { value: "modus-modern-light", label: "Modern Light" },
    { value: "modus-modern-dark", label: "Modern Dark" },
  ];

  // Primary event handling with direct DOM listeners
  useEffect(() => {
    const dropdown = dropdownRef.current;
    if (dropdown) {
      const handleItemSelect = (event: CustomEvent) => {
        const selectedValue = event.detail?.value as Theme;
        if (selectedValue && selectedValue !== theme) {
          setTheme(selectedValue);
          dropdown.menuVisible = false; // Close dropdown
        }
      };

      dropdown.addEventListener("itemSelect", handleItemSelect);

      return () => {
        dropdown.removeEventListener("itemSelect", handleItemSelect);
      };
    }
  }, [theme, setTheme]); // Include dependencies that affect the handler

  const getCurrentThemeLabel = () => {
    const currentTheme = themes.find((t) => t.value === theme);
    return currentTheme ? currentTheme.label : "Theme";
  };

  return (
    <div className={`theme-switcher-dropdown ${className}`}>
      <ModusWcDropdownMenu
        ref={dropdownRef}
        button-size="md"
        button-variant="primary"
        menu-placement="bottom-end"
        // Backup React event props (may not work reliably)
        onItemSelect={handleItemSelect}
        onMenuVisibilityChange={handleMenuVisibility}
      >
        <div slot="button" className="theme-button-content">
          <span className="theme-label">{getCurrentThemeLabel()}</span>
          <i className="modus-icons theme-arrow">expand_more</i>
        </div>
        <div slot="menu">
          {themes.map((themeOption) => (
            <ModusWcMenuItem
              key={themeOption.value}
              label={themeOption.label}
              value={themeOption.value}
              selected={theme === themeOption.value}
            />
          ))}
        </div>
      </ModusWcDropdownMenu>
    </div>
  );
}

// Hydration-safe wrapper
export default function ThemeSwitcherDropdown(
  props: ThemeSwitcherDropdownProps
) {
  const [mounted, setMounted] = useState(false);

  useEffect(() => {
    setMounted(true);
  }, []);

  if (!mounted) {
    return (
      <div className={`theme-switcher-dropdown ${props.className || ""}`}>
        <div className="animate-pulse">
          <div
            className="h-8 w-32 rounded"
            style={{ backgroundColor: "var(--modus-wc-color-base-200)" }}
          />
        </div>
      </div>
    );
  }

  return <ThemeSwitcherDropdownContent {...props} />;
}
```

