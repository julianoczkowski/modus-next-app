## 🚨 Common Mistakes to Avoid

### ❌ Don't Mix Color Systems

```tsx
// WRONG: Mixing Tailwind with Modus
<div className="bg-gray-100 p-4">
  <ModusWcButton color="primary">Button</ModusWcButton>
</div>
```

### ❌ Don't Hardcode Theme-Specific Values

```css
/* WRONG: Will break in dark theme */
.card {
  background: white;
  color: black;
}
```

### ❌ Don't Create Color Aliases

```css
/* WRONG: Don't create shortcuts */
:root {
  --bg: var(--modus-wc-color-base-page);
  --text: var(--modus-wc-color-base-content);
}
```

### ✅ Correct Approach with Inline Styles

```tsx
import { ModusWcButton } from "@trimble-oss/moduswebcomponents-react";

export default function Card() {
  return (
    <div
      className="card"
      style={{
        backgroundColor: "var(--modus-wc-color-base-page)",
        color: "var(--modus-wc-color-base-content)",
        border: "1px solid var(--modus-wc-color-base-200)",
        padding: "1rem",
      }}
    >
      <ModusWcButton color="primary">Button</ModusWcButton>
    </div>
  );
}
```

### ✅ Correct Approach with CSS Modules

```tsx
import { ModusWcButton } from "@trimble-oss/moduswebcomponents-react";
import styles from "./Card.module.css";

export default function Card() {
  return (
    <div className={styles.card}>
      <ModusWcButton color="primary">Button</ModusWcButton>
    </div>
  );
}
```

```css
/* Card.module.css */
.card {
  background-color: var(--modus-wc-color-base-page);
  color: var(--modus-wc-color-base-content);
  border: 1px solid var(--modus-wc-color-base-200);
  padding: 1rem;
}
```

