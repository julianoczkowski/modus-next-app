## 🏗️ Layout Architecture

### ✅ Global Layout Pattern

**ALWAYS** use the main layout for shared components:

```tsx
// app/layout.tsx
import AppHeader from "./components/AppHeader";
import AppFooter from "./components/AppFooter";
import { ThemeProvider } from "./contexts/ThemeContext";
import ModusProvider from "./components/ModusProvider";

export default function RootLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
    <html lang="en">
      <body
        style={{
          backgroundColor: "var(--modus-wc-color-base-page)",
          color: "var(--modus-wc-color-base-content)",
        }}
      >
        <ThemeProvider>
          <ModusProvider>
            <AppHeader />
            <main style={{ minHeight: "calc(100vh - 200px)" }}>{children}</main>
            <AppFooter />
          </ModusProvider>
        </ThemeProvider>
      </body>
    </html>
  );
}
```

```tsx
// ❌ WRONG: Adding header/footer to individual pages
export default function HomePage() {
  return (
    <div>
      <AppHeader /> {/* Don't do this */}
      <main>Content</main>
      <AppFooter /> {/* Don't do this */}
    </div>
  );
}
```

## 🧩 Component Development Guidelines

### ✅ Component Structure Template

```tsx
"use client"; // Only if needed for interactivity

import { ModusWcButton } from "@trimble-oss/moduswebcomponents-react";

interface ComponentProps {
  // Define all props with proper TypeScript types
  requiredProp: string;
  optionalProp?: boolean;
  onAction?: () => void;
}

export default function ComponentName({
  requiredProp,
  optionalProp = false,
  onAction,
}: ComponentProps) {
  // Component logic here

  return (
    <div
      style={{
        // Use Modus CSS variables
        backgroundColor: "var(--modus-wc-color-base-page)",
        color: "var(--modus-wc-color-base-content)",
      }}
    >
      <ModusWcButton color="primary" onButtonClick={onAction}>
        {requiredProp}
      </ModusWcButton>
    </div>
  );
}
```

### ✅ Event Handling Pattern

```tsx
// ✅ CORRECT: Proper event handling
const handleButtonClick = useCallback(() => {
  console.log("Button clicked!");
  onAction?.();
}, [onAction]);

return (
  <ModusWcButton onButtonClick={handleButtonClick}>Click me</ModusWcButton>
);
```

### ✅ Icon Integration Pattern

```tsx
