### Common Pitfalls

#### Event Handler Issues

```typescript
// ❌ WRONG - Missing event detail access
const handleItemSelect = (event: Event) => {
  // Missing: event.detail.value extraction
  setState(someHardcodedValue);
};

// ✅ CORRECT - Proper event detail handling
const handleItemSelect = (event: Event) => {
  const customEvent = event as CustomEvent;
  const selectedValue = customEvent.detail?.value;
  if (selectedValue) {
    setState(selectedValue);
  }
};
```

#### Menu Control Issues

```typescript
// ❌ WRONG - No menu close after selection
// Menu stays open, confusing UX

// ✅ CORRECT - Close menu after selection
dropdown.menuVisible = false;
```

#### Ref Issues

```typescript
// ❌ WRONG - Missing null check
const dropdown = dropdownRef.current;
dropdown.addEventListener(...); // Can throw if null

// ✅ CORRECT - Proper null checking
const dropdown = dropdownRef.current;
if (!dropdown) return;
dropdown.addEventListener(...);
```

### Performance Considerations

#### useEffect Dependencies

```typescript
// ❌ WRONG - Missing dependencies (ESLint warning)
useEffect(() => {
  // Uses logEvent but doesn't include it
}, []);

// ✅ CORRECT - Include all dependencies
useEffect(() => {
  // Event handler setup
}, [logEvent, selectedValue]);
```

#### Event Cleanup

```typescript
// ✅ CRITICAL - Always clean up event listeners
useEffect(() => {
  dropdown.addEventListener("itemSelect", handleItemSelect);
  return () => {
    dropdown.removeEventListener("itemSelect", handleItemSelect);
  };
}, []);
```

