if (!mounted) {
  return (
    <div className="max-w-6xl mx-auto p-8">
      <div className="animate-pulse">
        <div className="h-8 bg-muted rounded mb-8" />
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((i) => (
